# ==============================================================================
# DOC_Intelligence - Arquivo de Configuração de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto antes de rodar o Docker Compose:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Informações Gerais da Aplicação
# ------------------------------------------------------------------------------
PROJECT_NAME="DOC_Intelligence Backend"
API_V1_STR="/api/v1"
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Segurança, JWT e Autenticação
# ------------------------------------------------------------------------------
# ATENÇÃO: Em ambiente de produção, altere a SECRET_KEY para uma chave forte e randômica!
# Exemplo para gerar chave: openssl rand -hex 32
SECRET_KEY="super-secret-key-change-in-production-use-strong-random-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COLLECTION_LINK_EXPIRE_HOURS=48
BACKEND_CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 3. Superusuário Inicial (Auto-seeding no Startup da API)
# ------------------------------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@docintelligence.com
FIRST_SUPERUSER_PASSWORD=adminpassword123

# ------------------------------------------------------------------------------
# 4. Banco de Dados Relacional (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Para Docker Compose (comunicação interna na rede de containers):
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence

# ------------------------------------------------------------------------------
# 5. Mensageria, Cache e Filas (Redis 7 & Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# 6. Armazenamento de Documentos (MinIO S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=doc-intelligence-storage
MINIO_SECURE=false
# URL acessível pelos clientes/navegadores para download/visualização de documentos
MINIO_PUBLIC_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# 7. Motor de OCR e Limiares de Regras de Negócio (RN-01 a RN-08)
# ------------------------------------------------------------------------------
# OCR_ENGINE: 'mock' (simulação instantânea para dev/testes) ou 'easyocr' (PyTorch CRAFT em GPU/CPU)
OCR_ENGINE=mock
OCR_CONFIDENCE_THRESHOLD=0.85
TEMPLATE_DEDUCTION_THRESHOLD=0.90
FUZZY_MATCH_MIN_RATIO=0.80
FUZZY_MATCH_MAX_AUTO_RATIO=0.99
LOCK_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 8. Limites de Segurança de Arquivos e Rasterização
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=26214400
MAX_IMAGE_PIXELS=89000000
MAX_PDF_PAGES=10
PDF_RASTERIZE_DPI=300
