# ==============================================================================
# DOC_Intelligence Backend - Configurações Locais de Desenvolvimento (.env)
# ==============================================================================

# Application Settings
PROJECT_NAME="DOC_Intelligence Backend"
API_V1_STR="/api/v1"
DEBUG=true

# Security & Authentication
SECRET_KEY="super-secret-key-change-in-production-use-strong-random-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COLLECTION_LINK_EXPIRE_HOURS=48
BACKEND_CORS_ORIGINS=["*"]

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_intelligence

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=doc-intelligence-storage
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# OCR & Quality Thresholds (Regras de Negócio RN-01 a RN-04)
# Configuração do Motor de OCR: 'mock' (simulação rápida 80% sucesso / 20% manual) ou 'easyocr' (PyTorch)
OCR_ENGINE=mock
OCR_CONFIDENCE_THRESHOLD=0.85
TEMPLATE_DEDUCTION_THRESHOLD=0.90
FUZZY_MATCH_MIN_RATIO=0.80
FUZZY_MATCH_MAX_AUTO_RATIO=0.99
LOCK_TTL_SECONDS=600

# File Inspection & Security Limits
MAX_FILE_SIZE_BYTES=26214400
MAX_IMAGE_PIXELS=89000000
MAX_PDF_PAGES=10
PDF_RASTERIZE_DPI=300

# Default Admin User
FIRST_SUPERUSER_EMAIL=admin@docintelligence.com
FIRST_SUPERUSER_PASSWORD=adminpassword123
